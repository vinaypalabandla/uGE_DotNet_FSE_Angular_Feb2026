@model ContactInfo

<h2 class="text-center text-primary">Add Contact</h2>

<div class="container mt-4" style="max-width:500px;">
    <form method="post" asp-action="AddContact">

        <div class="mb-3">
            <label class="form-label">Contact Id</label>
            <input asp-for="ContactId" class="form-control" />
            <span asp-validation-for="ContactId"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">First Name</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Company Name</label>
            <input asp-for="CompanyName" class="form-control" />
            <span asp-validation-for="CompanyName"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="EmailId" class="form-control" />
            <span asp-validation-for="EmailId"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Mobile</label>
            <input asp-for="MobileNo" class="form-control" />
            <span asp-validation-for="MobileNo"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Designation</label>
            <input asp-for="Designation" class="form-control" />
            <span asp-validation-for="Designation"></span>
        </div>

        <button type="submit" class="btn btn-primary ">
            Save Contact
        </button>

    </form>
</div>