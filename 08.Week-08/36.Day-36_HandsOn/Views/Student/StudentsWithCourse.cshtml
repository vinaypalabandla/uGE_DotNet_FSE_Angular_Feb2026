@model IEnumerable<WebApplication6.Models.Student>

<h2>Students with Course</h2>

<table class="table">
    <tr>
        <th>Student Name</th>
        <th>Course Name</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.StudentName</td>
            <td>@item.Course?.CourseName</td>
        </tr>
    }
</table>