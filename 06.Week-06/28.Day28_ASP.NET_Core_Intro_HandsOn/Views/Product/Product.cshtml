@model List<WebApplication1.Models.Product>

<h2>Product List</h2>

<table border="2" cellpadding="10" cellspacing="0" class="table table-dark table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Category</th>
            <th>Single Product information</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Category</td>
                <td>
                    <a href="/Product/Details/@item.Id">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>