@model List<WebApplication5.Models.ContactInfo>

<h2>Contacts</h2>

<table class="table">
    <tr class="table-dark">
        <th>Name</th>
        <th>Email</th>
        <th>Mobile</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FirstName @item.LastName</td>
            <td>@item.EmailId</td>
            <td>@item.MobileNo</td>
            <td>
                <a asp-action="EditContact" asp-route-id="@item.ContactId">Edit</a> |
                <a asp-action="DeleteContact" asp-route-id="@item.ContactId">Delete</a>
            </td>
        </tr>
    }
</table>

<a asp-action="AddContact">Add New</a>