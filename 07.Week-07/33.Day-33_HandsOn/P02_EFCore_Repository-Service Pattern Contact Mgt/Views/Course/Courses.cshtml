@using WebApplication4.Models﻿
@model List<Course>


<table class="table">

    <tr>
        <th>Course Id</th>
        <th>Course Name</th>

    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CourseId</td>
            <td>@item.CourseName</td>
           
            <td>

                <ul>
                    @foreach (var stu in item.Students)
                    {
                        <li>@stu.StudentName</li>
                    }
                </ul>

            </td>

        </tr>
    }

</table>