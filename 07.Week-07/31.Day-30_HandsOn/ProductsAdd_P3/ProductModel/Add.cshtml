<h2>Add Product</h2>

<form method="post" action="/product/index">
    <label>Name:</label>
    <input type="text" name="name" /><br />

    <label>Price:</label>
    <input type="number" name="price" /><br />

    <label>Quantity:</label>
    <input type="number" name="quantity" /><br />

    <button type="submit">Add</button>
</form>